  {
   "op": "nar",
   "text": "そう言うと、若者の姿は、夕闇の中に、ふっと、消えた。"
  },
  {
   "op": "say",
   "actor": "iwao",
   "text": "……今の若者は、どこへ。",
   "eyes": "surprise"
  },
  {
   "op": "say",
   "actor": "extra_villager",
   "text": "……煙のように、いなくなった。",
   "eyes": "surprise"
