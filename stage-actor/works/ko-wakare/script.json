      "op": "nar",
      "text": "鰻屋。三人は別々の席に座り、亀が真ん中へ約束帳を置く。"
    },
    {
      "op": "show",
      "actor": "extra_craftsman",
      "pos": "left"
    },
    {
      "op": "show",
      "actor": "shiro",
