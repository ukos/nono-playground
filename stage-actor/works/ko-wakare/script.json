    {
      "op": "show",
      "actor": "shiro",
      "pos": "right"
    },
    {
      "op": "say",
      "actor": "extra_craftsman",
      "text": "亀、大きくなったな。母ちゃんは元気か。",
      "eyes": "sorrow"
    },
    {
      "op": "say",
      "actor": "shiro",
      "text": "元気。でも父ちゃんの話をすると、黙る。"
    },
    {
      "op": "say",
      "actor": "extra_craftsman",
      "text": "当然だ。会ってくれとは言えない。"
