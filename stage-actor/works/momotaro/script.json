    {
      "op": "say",
      "actor": "extra_oni",
      "text": "ならば、島の扉も村の門も、同じ日に開く。",
      "eyes": "joy"
    },
    {
      "op": "nar",
      "text": "三者は新しい目録へ署名し、古い箱に双方の印を付ける。"
    },
    {
      "op": "hide",
      "actor": "kurogane"
    },
    {
      "op": "hide",
      "actor": "extra_oni"
    },
    {
