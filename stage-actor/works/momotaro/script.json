    },
    {
      "op": "say",
      "actor": "nono",
      "text": "正義は宝を奪う旗ではなく、持ち主を見つける灯りなのかもしれません。",
      "eyes": "joy",
      "mouth": "open"
    },
    {
      "op": "hide",
