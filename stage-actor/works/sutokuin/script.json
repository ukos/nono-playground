   "op": "say",
   "actor": "gou",
   "text": "なんや、そんなことかいな！　わはははは！",
   "eyes": "joy"
  },
  {
   "op": "say",
   "actor": "rei_casual",
   "text": "笑うたやないか。"
  },
  {
